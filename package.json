{
  "name": "webmcp-verified",
  "version": "0.7.0",
  "description": "Source-grounded MCP/WebMCP tool library. Tools answer from data you declare or return a declared fallback, never an invented value, and can emit a fingerprinted receipt per answer. Zero runtime deps, ESM, MIT.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": "./src/index.js",
    "./harness": "./src/harness.js"
  },
  "files": [
    "src",
    "examples",
    "scripts",
    "test",
    "EVIDENCE.md",
    "ROADMAP.md",
    "README.md",
    "EXPLAINER.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs",
    "example": "node examples/auto-shop.mjs",
    "evidence": "node scripts/evidence.mjs",
    "discovery": "node scripts/discovery.mjs",
    "overlap": "node scripts/overlap.mjs",
    "tokenizer": "node scripts/tokenizer-check.mjs",
    "used-curve": "node scripts/used-curve.mjs",
    "real-mcp": "node scripts/real-mcp.mjs",
    "cache-curve": "node scripts/cache-curve.mjs"
  },
  "keywords": [
    "mcp",
    "webmcp",
    "model-context-protocol",
    "navigator.modelContext",
    "mcp-tools",
    "ai-agents",
    "agent-tools",
    "tool-calling",
    "source-grounded",
    "grounded-tools",
    "tool-provenance",
    "audit-trail",
    "token-efficient",
    "zero-dependencies"
  ],
  "license": "MIT",
  "author": "Nightflow Systems",
  "repository": {
    "type": "git",
    "url": "https://github.com/xnfinite/webmcp-verified"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "devDependencies": {
    "gpt-tokenizer": "^4.0.0"
  }
}
